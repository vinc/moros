#! lisp

(load "/lib/lisp/core.lsp")

(set addr 0)
(set labels (dict))

(def (encode-u32 n)
  (slice (reverse (num->bin n)) 0 4))

(def (encode-str s) (do
    (set addr (+ addr (len s)))
    (str->bin s)))

(def (reg-id name)
  (case name
    ("eax" 0)
    ("ecx" 1)
    ("edx" 2)
    ("ebx" 3)
    ("esp" 4)
    ("ebp" 5)
    ("esi" 6)
    ("edi" 7)
    ("rax" 0)
    ("rcx" 1)
    ("rdx" 2)
    ("rbx" 3)
    ("rsp" 4)
    ("rbp" 5)
    ("rsi" 6)
    ("rdi" 7)))

(def (asm-int params) (do
  (set addr (+ addr 2))
  (list 0xCD (str->num (get params 0)))))

(def (asm-lea params) (do
  (set reg (get params 0))
  (set key (get params 1))
  (if (and (eq? (first key) "[") (eq? (last key) "]"))
    (set key (slice key 1 (- (len key) 2))))
  (set src (+ 0x05 (* (reg-id reg) 8)))
  (case (get reg 0)
    ("e" (do
      (set addr (+ addr 6))
      (list 0x8D src key)))
    ("r" (do
      (set addr (+ addr 7))
      (list 0x48 0x8D src key))))))

(def (asm-mov params) (do
  (set reg (get params 0))
  (concat
    (case (get reg 0)
      ("e" (do
        (set addr (+ addr 5))
        (list (+ 0xB8 (reg-id reg)))))
      ("r" (do
        (set addr (+ addr 7))
        (list 0x48 0xC7 (+ 0xC0 (reg-id reg))))))
    (encode-u32 (str->num (get params 1))))))

(def (parse-line line) (do
  (set line (str/trim (head (str/split line "#"))))
  (set params (words line))
  (set op (head params))

  # label
  (if (eq? (last op) ":") (do
    (put! labels (slice op 0 (- (len op) 1)) addr)
    (if (> (len params) 1) (do
      (set params (tail params))
      (set op (head params))))))

  # instr
  (if (> (len params) 1) (do
    (set params (tail params))
    (if (not (empty? op))
      (case op
        ("str" (encode-str (parse (str/join params " "))))
        ("int" (asm-int params))
        ("lea" (asm-lea params))
        ("mov" (asm-mov params))))))))

(def (parse-file file)
  (reduce concat (reverse (map parse-line (reverse (lines file))))))

(def (replace-labels buf i)
  (if (not (empty? buf)) (do
    (var cur (head buf))
    (var res (tail buf))
    (if (str? cur) (do
      (var ptr (encode-u32 (- (get labels cur) (+ i 4))))
      (set cur (head ptr))
      (set res (concat (tail ptr) res))))
    (cons cur (replace-labels res (+ i 1))))))

(if (< (len args) 2) "Usage: asm <file.asm> <file.bin>" (do
  (set file-asm (get args 0))
  (set file-bin (get args 1))
  (set buf (parse-file (read file-asm)))
  (set buf (replace-labels buf 0))
  (write-binary file-bin (concat
    (cons 0x7F (str->bin "BIN"))
    buf))))
